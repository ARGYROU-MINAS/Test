<?xml version="1.0" encoding="utf-8"?>
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
    IgnorableNamespaces="uap mp">
    <Identity
        Name="48508ArgyrouMinas.eu.argyrouminas.test"
        Publisher="CN=C864DBCB-FDA0-47B0-AFB3-BC7C2899BD5F"
        Version="1.0.2.0" />
    <mp:PhoneIdentity
        PhoneProductId="b64e7f0d-53c2-56f3-84e6-e06e5354257b"
        PhonePublisherId="00000000-0000-0000-0000-000000000000" />
    <Properties>
        <DisplayName>eu.argyrouminas.test</DisplayName>
        <PublisherDisplayName>ARGYROU MINAS</PublisherDisplayName>
        <Logo>Assets\StoreLogo.png</Logo>
    </Properties>
    <Dependencies>
        <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
    </Dependencies>
    <Resources>
        <Resource Language="en-US" />
    </Resources>
    <Applications>
        <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="ArgyrouMinas.HelloWorld.App">
            <uap:VisualElements
                DisplayName="eu.argyrouminas.test"
                Description="A minimal Hello World app"
                Square150x150Logo="Assets\Square150x150Logo.png"
                Square44x44Logo="Assets\Square44x44Logo.png"
                BackgroundColor="#1976D2">
                <uap:SplashScreen Image="Assets\SplashScreen.png" />
            </uap:VisualElements>
        </Application>
    </Applications>
</Package>
